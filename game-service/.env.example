PORT=8080
# Required in production. Coolify should provide its Postgres internal connection string here.
DATABASE_URL=postgres://medieval:medieval@localhost:54329/medieval
MEDIEVAL_GAME_TOKEN=change-me
# Keep this false/blank in production. Set true only for an intentionally public dev service.
MEDIEVAL_ALLOW_UNAUTHENTICATED=false
CORS_ORIGIN=*
DB_WAIT_TIMEOUT_MS=60000
DB_WAIT_INTERVAL_MS=1500
SHUTDOWN_TIMEOUT_MS=10000
