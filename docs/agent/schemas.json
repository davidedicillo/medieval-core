{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medieval:documentation:schemas:v1",
  "title": "MediEval recommended client payloads",
  "description": "Portable client contracts. Not an assertion that runtime rejects every extra field or older compatibility form. Resolve local $defs references within this document.",
  "$defs": {
    "Answer": { "type": "string", "enum": ["yes", "no", "unsure", "bad_question", "skip"] },
    "Correction": { "type": "object", "properties": { "correctAnswer": { "type": "string" }, "reasonTags": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
    "Card": {
      "type": "object", "required": ["schemaVersion", "cardId", "cardType", "question", "sourceKey", "claim"],
      "properties": {
        "schemaVersion": { "const": "eval-card.v1" }, "cardId": { "type": "string", "minLength": 1 }, "cardType": { "const": "binary_claim" },
        "question": { "type": "string", "minLength": 1 }, "sourceKey": { "type": "string", "minLength": 1 },
        "claim": { "type": "object", "required": ["template", "path", "value"], "properties": { "template": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "priority": { "type": "string" },
        "subject": { "type": "object" }, "analysisContext": { "type": "object" }, "evidence": { "type": "array" }, "media": { "type": "array" }, "images": { "type": "array" }
      }, "additionalProperties": true
    },
    "Result": {
      "type": "object", "required": ["eventId", "cardId", "reviewer", "answer", "rubricVersion"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1, "maxLength": 200 }, "cardId": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 },
        "answer": { "$ref": "#/$defs/Answer" }, "rubricVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "correction": { "$ref": "#/$defs/Correction" }, "notes": { "type": "string" }, "durationMs": { "type": "number", "minimum": 0 }, "clientGeneratedAt": { "type": "string", "format": "date-time" }
      }, "additionalProperties": true
    },
    "GenericRecord": {
      "type": "object", "required": ["id", "question", "value"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 }, "explanation": { "type": "string" } }, "additionalProperties": true
    },
    "Preview": {
      "type": "object", "required": ["projectId", "adapter"],
      "properties": { "projectId": { "type": "string", "minLength": 1 }, "batchId": { "type": "string" }, "adapter": { "enum": ["generic", "myfire-rating"] }, "format": { "enum": ["auto", "csv", "json", "jsonl"] }, "raw": { "type": "string" }, "records": { "type": "array", "items": { "type": "object" }, "minItems": 1 } },
      "anyOf": [{ "required": ["raw"] }, { "required": ["records"] }], "additionalProperties": true
    },
    "PlatformBatch": { "allOf": [{ "$ref": "#/$defs/Preview" }, { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "description": { "type": "string", "maxLength": 4000 }, "audience": { "enum": ["invited", "workspace"] } } }] },
    "Import": {
      "type": "object", "required": ["projectId", "batchId", "cards"],
      "properties": { "projectId": { "type": "string", "minLength": 1 }, "batchId": { "type": "string", "minLength": 1 }, "replace": { "type": "boolean", "default": false }, "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Card" } } }, "additionalProperties": true
    },
    "QualitySettings": {
      "type": "object", "properties": {
        "mode": { "enum": ["solo", "team"], "default": "solo" }, "calibration": { "enum": ["off", "optional", "required"], "default": "optional" },
        "rubricVersion": { "type": "string", "minLength": 1, "maxLength": 100, "default": "1" }, "rubric": { "type": "string", "maxLength": 20000, "default": "" },
        "expertReviewers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "default": [] },
        "minReviews": { "type": "integer", "minimum": 2, "maximum": 20, "default": 2 }, "consensusThreshold": { "type": "number", "exclusiveMinimum": 0.5, "maximum": 1, "default": 1 },
        "qualificationCount": { "type": "integer", "minimum": 1, "maximum": 500, "default": 30 }, "passRate": { "type": "number", "exclusiveMinimum": 0.5, "maximum": 1, "default": 0.9 },
        "checkEvery": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 10 }, "consistencyEvery": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0 }
      }, "additionalProperties": false
    },
    "Reference": {
      "type": "object", "required": ["kind", "answer", "explanation"],
      "properties": { "cardId": { "type": "string", "minLength": 1 }, "card": { "$ref": "#/$defs/Card" }, "kind": { "enum": ["practice", "qualification", "check"] }, "answer": { "enum": ["yes", "no", "unsure", "bad_question"] }, "explanation": { "type": "string", "minLength": 1, "maxLength": 20000 } },
      "anyOf": [{ "required": ["cardId"] }, { "required": ["card"] }], "additionalProperties": false
    },
    "Adjudication": {
      "type": "object", "required": ["cardId", "answer", "rationale", "basisEventIds"],
      "properties": { "cardId": { "type": "string", "minLength": 1 }, "answer": { "enum": ["yes", "no", "unsure", "bad_question"] }, "rationale": { "type": "string", "minLength": 1, "maxLength": 20000 }, "basisEventIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "correction": { "$ref": "#/$defs/Correction" } }, "additionalProperties": false
    },
    "ResolvedStatus": { "enum": ["pending", "reviewed", "expert_reviewed", "awaiting_reviews", "needs_adjudication", "consensus", "adjudicated"] }
  }
}
