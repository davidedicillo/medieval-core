{
  "schemaVersion": "medieval-api-catalog.v1",
  "scope": "Selected supported application operations; Better Auth internals and optional game API are documented separately.",
  "guide": "../API_REFERENCE.md",
  "schemas": "schemas.json",
  "conventions": {
    "pathParameters": "Braced placeholders are required and URL encoded.",
    "successStatus": 200,
    "contentType": "application/json unless responseMediaTypes specifies exports",
    "authentication": {
      "public": "No credentials; documentation and liveness only.",
      "account": "Verified email session cookie or signed set-auth-token bearer session. Cookie writes require same-origin Origin; supplied Origin must always match.",
      "shared-token": "Configured bearer token or x-eval-mobile-token; no independent account identity.",
      "review-context": "Account session on platform; shared token on eval-api. See context parameters."
    },
    "contextParameters": {
      "platform": { "requiredQuery": ["batchId"], "optionalQuery": ["projectId", "workspaceId"], "note": "runId aliases batchId. Identity is session-derived. Quality routes validate projectId; workspace is derived from authorized batch. Other mobile routes also validate supplied workspaceId." },
      "eval-api": { "recommendedQuery": ["projectId", "batchId", "reviewer"], "note": "Defaults exist for compatibility; explicit context is recommended. Keep result body reviewer equal to query reviewer." }
    },
    "errors": { "400": "Invalid payload", "401": "Missing/invalid authentication", "403": "Access, publication, qualification, or Origin gate", "404": "Route/resource not available", "409": "Stale/conflicting state", "413": "Account JSON body exceeds 2 MB", "429": "Authentication rate limit", "500": "Server failure; outcome may be uncertain" },
    "retryValues": { "read": "Repeat authorized read", "read-before-repeat": "Inspect durable state before repeating an uncertain mutation", "same-event-id": "Retry same persisted eventId and body; do not create a new ID", "refresh-on-conflict": "Refresh current evidence and reconsider on 409", "rate-limited": "Do not loop requests; respect provider/server rate limits" }
  },
  "operations": [
    { "id": "health", "method": "GET", "path": "/healthz", "services": ["platform", "eval-api"], "auth": "public", "responseFields": ["ok", "service"], "sideEffects": [], "retry": "read" },
    { "id": "send-sign-in-code", "method": "POST", "path": "/api/auth/email-otp/send-verification-otp", "services": ["platform"], "auth": "public", "request": { "required": ["email", "type"], "fields": { "email": "email address", "type": "sign-in" } }, "responseFields": ["success"], "sideEffects": ["sends email", "rate-limit counters"], "retry": "rate-limited" },
    { "id": "sign-in", "method": "POST", "path": "/api/auth/sign-in/email-otp", "services": ["platform"], "auth": "public", "request": { "required": ["email", "otp"], "fields": { "email": "same address", "otp": "six-digit string", "name": "optional display name" } }, "responseFields": ["user", "token"], "responseHeaders": ["set-cookie", "set-auth-token"], "sideEffects": ["creates or verifies account", "creates session"], "retry": "rate-limited" },
    { "id": "sign-out", "method": "POST", "path": "/api/auth/sign-out", "services": ["platform"], "auth": "account", "responseFields": ["success"], "sideEffects": ["revokes session"], "retry": "read-before-repeat" },
    { "id": "identity", "method": "GET", "path": "/api/me", "services": ["platform"], "auth": "account", "responseFields": ["user", "workspaces", "invitations"], "sideEffects": [], "retry": "read" },
    { "id": "discover-batches", "method": "GET", "path": "/api/me/batches", "services": ["platform"], "auth": "account", "responseFields": ["batches"], "sideEffects": [], "retry": "read" },
    { "id": "platform-state", "method": "GET", "path": "/api/platform/state", "services": ["platform"], "auth": "account", "responseFields": ["user", "workspaces", "projects", "batches", "invitations"], "sideEffects": [], "retry": "read" },
    { "id": "create-workspace", "method": "POST", "path": "/api/platform/workspaces", "services": ["platform"], "auth": "account", "request": { "required": ["name"], "fields": { "name": "nonempty string, <=200 characters" } }, "responseFields": ["workspace"], "sideEffects": ["creates workspace and owner membership"], "retry": "read-before-repeat" },
    { "id": "create-project", "method": "POST", "path": "/api/platform/projects", "services": ["platform"], "auth": "account", "role": "manager", "request": { "required": ["workspaceId", "name"], "fields": { "workspaceId": "discovered ID", "name": "nonempty string, <=200 characters" } }, "responseFields": ["project"], "sideEffects": ["creates project"], "retry": "read-before-repeat" },
    { "id": "platform-preview", "method": "POST", "path": "/api/platform/preview", "services": ["platform"], "auth": "account", "role": "manager", "requestSchema": "Preview", "responseFields": ["cards", "warnings", "cardCount"], "sideEffects": [], "retry": "read" },
    { "id": "create-draft", "method": "POST", "path": "/api/platform/batches", "services": ["platform"], "auth": "account", "role": "manager", "requestSchema": "PlatformBatch", "responseFields": ["batch", "cardCount"], "sideEffects": ["creates draft", "imports generated cards"], "retry": "read-before-repeat" },
    { "id": "batch-detail", "method": "GET", "path": "/api/platform/batches/{id}", "services": ["platform"], "auth": "account", "role": "manager", "responseFields": ["batch", "detail"], "sideEffects": [], "retry": "read" },
    { "id": "update-publication", "method": "POST", "path": "/api/platform/batches/{id}", "services": ["platform"], "auth": "account", "role": "manager", "request": { "fields": { "status": ["draft", "active", "paused", "archived"], "audience": ["invited", "workspace"] } }, "responseFields": ["batch"], "sideEffects": ["changes reviewer visibility and write access"], "retry": "read-before-repeat" },
    { "id": "batch-access", "method": "GET", "path": "/api/platform/batches/{id}/members", "services": ["platform"], "auth": "account", "role": "manager", "responseFields": ["members", "invitations"], "sideEffects": [], "retry": "read" },
    { "id": "invite", "method": "POST", "path": "/api/platform/invitations", "services": ["platform"], "auth": "account", "role": "manager; owner to invite admin", "request": { "required": ["workspaceId", "email"], "fields": { "workspaceId": "ID", "email": "recipient address", "batchId": "optional ID; forces guest role", "role": ["reviewer", "admin"] } }, "responseFields": ["invitation", "inviteUrl"], "sideEffects": ["creates seven-day invitation", "sends email"], "retry": "read-before-repeat", "authorizationNote": "Requires explicit user authorization to send the invitation message." },
    { "id": "accept-invitation", "method": "POST", "path": "/api/invitations/accept", "services": ["platform"], "auth": "account", "request": { "oneOfRequired": [["token"], ["invitationId"]] }, "responseFields": ["workspaceId", "batchId"], "sideEffects": ["creates membership and optional assignment"], "retry": "read-before-repeat" },
    { "id": "revoke-invitation", "method": "POST", "path": "/api/platform/invitations/{id}/revoke", "services": ["platform"], "auth": "account", "role": "manager", "responseFields": ["ok"], "sideEffects": ["revokes invitation"], "retry": "read-before-repeat" },
    { "id": "remove-batch-access", "method": "POST", "path": "/api/platform/batches/{id}/access", "services": ["platform"], "auth": "account", "role": "manager", "request": { "required": ["userId"] }, "responseFields": ["ok"], "sideEffects": ["removes direct assignment; workspace access can still apply"], "retry": "read-before-repeat" },
    { "id": "workspace-members", "method": "GET", "path": "/api/platform/workspaces/{id}/members", "services": ["platform"], "auth": "account", "role": "manager", "responseFields": ["members"], "sideEffects": [], "retry": "read" },
    { "id": "remove-member", "method": "POST", "path": "/api/platform/workspaces/{id}/members/{userId}", "services": ["platform"], "auth": "account", "role": "manager; only owner can remove admin; owner cannot be removed", "responseFields": ["ok"], "sideEffects": ["removes workspace membership and assignments", "revokes workspace invitations to user"], "retry": "read-before-repeat" },
    { "id": "review-deck", "method": "GET", "path": "/api/mobile/eval/cards", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "query": { "limit": "page size, default 20", "page": "page number, default 1", "reviewState": "eval-api only" }, "responseFields": ["cards", "page", "pageSize", "pageCount", "total"], "cardRubricFields": { "production": ["reviewRubric.version", "reviewRubric.text"], "quality": ["quality.rubricVersion", "quality.rubric"] }, "sideEffects": ["may create an automatic quality assignment"], "retry": "read" },
    { "id": "review-summary", "method": "GET", "path": "/api/mobile/eval/summary", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "responseFields": ["summary"], "sideEffects": [], "retry": "read" },
    { "id": "submit-result", "method": "POST", "path": "/api/mobile/eval/results", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "requestSchema": "Result", "responseFields": ["ok", "stored", "duplicate"], "optionalResponseFields": ["qualityFeedback"], "sideEffects": ["appends production result or stores separate quality attempt"], "retry": "same-event-id" },
    { "id": "export-results", "method": "GET", "path": "/api/eval/results/export", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "query": { "format": ["jsonl", "csv"] }, "responseMediaTypes": ["application/x-ndjson", "text/csv"], "responseFields": [], "sideEffects": [], "retry": "read", "visibility": "Platform managers: all; other reviewers: own production rows only." },
    { "id": "own-quality", "method": "GET", "path": "/api/mobile/eval/quality", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "responseFields": ["settings", "qualification", "qualificationRequired", "isProjectExpert", "qualityXP", "feedback"], "sideEffects": [], "retry": "read" },
    { "id": "quality-deck", "method": "GET", "path": "/api/mobile/eval/quality/cards", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "query": { "kind": ["practice", "qualification", "check", "consistency"] }, "responseFields": ["cards"], "sideEffects": ["creates/reuses persistent assignment; not a purely observational GET"], "retry": "read" },
    { "id": "manager-quality", "method": "GET", "path": "/api/eval/quality", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "role": "manager on platform", "responseFields": ["settings", "references", "labels", "settingsHistory", "reviewerQuality"], "sideEffects": [], "retry": "read" },
    { "id": "configure-quality", "method": "POST", "path": "/api/eval/quality/settings", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "role": "manager on platform", "requestSchema": "QualitySettings", "responseFields": ["settings"], "sideEffects": ["records previous settings", "changes current rubric/policy and resolution"], "retry": "read-before-repeat" },
    { "id": "add-reference", "method": "POST", "path": "/api/eval/quality/references", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "role": "manager on platform", "requestSchema": "Reference", "responseFields": ["reference"], "sideEffects": ["reserves source from production permanently", "stores expected answer and author"], "retry": "read-before-repeat" },
    { "id": "retire-reference", "method": "POST", "path": "/api/eval/quality/references/retire", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "role": "manager on platform", "request": { "required": ["id"] }, "responseFields": ["ok"], "sideEffects": ["retires reference; may invalidate qualification; source remains reserved"], "retry": "read-before-repeat" },
    { "id": "adjudicate", "method": "POST", "path": "/api/eval/quality/adjudications", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "role": "manager on platform", "requestSchema": "Adjudication", "responseFields": ["adjudication"], "sideEffects": ["appends resolution with evidence basis and independence flag"], "retry": "refresh-on-conflict" },
    { "id": "export-resolved", "method": "GET", "path": "/api/eval/quality/export", "services": ["platform", "eval-api"], "auth": "review-context", "context": true, "role": "manager on platform", "query": { "format": ["jsonl", "csv"] }, "responseMediaTypes": ["application/x-ndjson", "text/csv"], "responseFields": [], "sideEffects": [], "retry": "read" },
    { "id": "list-projects", "method": "GET", "path": "/api/eval/projects", "services": ["eval-api"], "auth": "shared-token", "responseFields": ["projects"], "sideEffects": [], "retry": "read" },
    { "id": "put-project", "method": "POST", "path": "/api/eval/projects", "services": ["eval-api"], "auth": "shared-token", "request": { "fields": { "projectId": "operator-chosen ID", "name": "display name", "description": "optional text" } }, "responseFields": ["project"], "sideEffects": ["creates/updates project metadata"], "retry": "read-before-repeat" },
    { "id": "list-batches", "method": "GET", "path": "/api/eval/batches", "services": ["eval-api"], "auth": "shared-token", "query": { "projectId": "optional ID", "reviewer": "optional name" }, "responseFields": ["batches"], "sideEffects": [], "retry": "read" },
    { "id": "put-batch", "method": "POST", "path": "/api/eval/batches", "aliases": ["/api/eval/runs"], "services": ["eval-api"], "auth": "shared-token", "request": { "fields": { "projectId": "ID", "batchId": "ID; runId alias", "name": "display name", "description": "optional text" } }, "responseFields": ["batch", "run"], "sideEffects": ["creates/updates batch metadata"], "retry": "read-before-repeat" },
    { "id": "eval-batch-detail", "method": "GET", "path": "/api/eval/batches/detail", "services": ["eval-api"], "auth": "shared-token", "context": true, "responseFields": ["batch", "cards", "recentResults"], "sideEffects": [], "retry": "read" },
    { "id": "eval-preview", "method": "POST", "path": "/api/eval/cards/preview", "services": ["eval-api"], "auth": "shared-token", "requestSchema": "Preview", "responseFields": ["cards", "warnings", "cardCount", "recordsPreview", "recordCount"], "sideEffects": [], "retry": "read" },
    { "id": "import-cards", "method": "POST", "path": "/api/eval/cards/import", "services": ["eval-api"], "auth": "shared-token", "requestSchema": "Import", "alternativeRequest": "application/x-ndjson with projectId/batchId query", "responseFields": ["ok"], "sideEffects": ["imports canonical cards", "replace resets deck but retains histories"], "retry": "read-before-repeat" },
    { "id": "dashboard-state", "method": "GET", "path": "/api/eval/dashboard/state", "services": ["eval-api"], "auth": "shared-token", "context": true, "responseFields": ["projects", "batches", "selectedBatch", "recentResults"], "sideEffects": [], "retry": "read" }
  ]
}
