{
  "schemaVersion": "medieval-docs.v1",
  "product": "MediEval",
  "documentationVersion": "1.0.0",
  "reviewedOn": "2026-10-19",
  "scope": "source-checkout",
  "deploymentAvailability": "Probe the target service; this manifest is not proof of hosted rollout or App Store availability.",
  "entrypoints": { "human": "/docs", "agent": "/docs/agent/manifest.json", "discovery": "/llms.txt", "combinedGuides": "/llms-full.txt" },
  "services": {
    "platform": { "healthService": "medieval-platform", "authentication": "email-otp-session", "storage": ["PostgreSQL", "workspace-specific card/result files", "batch quality.json"], "defaultPort": 5183 },
    "eval-api": { "healthService": "medieval-eval-api", "authentication": "shared-token", "identity": "caller-supplied reviewer; not verified human identity", "storage": ["card/result files", "batch quality.json"], "defaultPort": 5182 },
    "legacy-demo": { "authentication": "demo-token", "storage": ["memory"], "defaultPort": 5199, "qualitySupported": false },
    "game-service": { "optional": true, "purpose": "participation rewards and leaderboard; not label storage or reliability" }
  },
  "capabilities": [
    { "id": "account-workspaces", "implementation": "present", "services": ["platform"], "guide": "docs/WORKSPACES.md" },
    { "id": "imports-review-exports", "implementation": "present", "services": ["platform", "eval-api"], "guide": "docs/QUICKSTART.md" },
    { "id": "quality", "implementation": "present", "services": ["platform", "eval-api"], "scope": "batch-and-rubric-version", "calibrationDefault": "optional", "expertGateExemption": true, "guide": "docs/QUALITY.md" },
    { "id": "ios-outbox", "implementation": "present", "scope": "server-account-workspace-project-batch", "guide": "docs/IOS_REVIEWER.md" },
    { "id": "advanced-assignment-routing", "implementation": "not-implemented" },
    { "id": "general-reviewer-reliability-model", "implementation": "not-implemented" },
    { "id": "distributed-file-store-writes", "implementation": "not-supported" }
  ],
  "documents": [
    { "id": "index", "file": "docs/README.md", "title": "Documentation", "audience": ["all"], "combined": true },
    { "id": "quickstart", "file": "docs/QUICKSTART.md", "title": "First batch", "audience": ["owner", "reviewer"], "combined": true },
    { "id": "concepts", "file": "docs/CONCEPTS.md", "title": "Concepts and glossary", "audience": ["all"], "combined": true },
    { "id": "workspaces", "file": "docs/WORKSPACES.md", "title": "Workspace administration", "audience": ["owner", "admin"], "combined": true },
    { "id": "importing", "file": "docs/IMPORTING.md", "title": "Importing data", "audience": ["owner", "admin", "developer"], "combined": true },
    { "id": "reviewing", "file": "docs/REVIEWING.md", "title": "Web review", "audience": ["reviewer"], "combined": true },
    { "id": "ios-reviewer", "file": "docs/IOS_REVIEWER.md", "title": "iOS reviewer", "audience": ["reviewer"], "combined": true },
    { "id": "quality", "file": "docs/QUALITY.md", "title": "Quality workflows", "audience": ["owner", "admin", "reviewer"], "combined": true },
    { "id": "exporting", "file": "docs/EXPORTING.md", "title": "Exports", "audience": ["owner", "admin", "developer"], "combined": true },
    { "id": "operations", "file": "docs/OPERATIONS.md", "title": "Operations", "audience": ["operator"], "combined": true },
    { "id": "troubleshooting", "file": "docs/TROUBLESHOOTING.md", "title": "Troubleshooting", "audience": ["all"], "combined": true },
    { "id": "agents", "file": "docs/AGENTS.md", "title": "Agent integration", "audience": ["agent", "developer"], "combined": true },
    { "id": "api-reference", "file": "docs/API_REFERENCE.md", "title": "API reference", "audience": ["agent", "developer"], "combined": true },
    { "id": "card-schema", "file": "docs/CARD_SCHEMA.md", "title": "Card and result contract", "audience": ["developer"] },
    { "id": "adapters", "file": "docs/ADAPTER_GUIDE.md", "title": "Adapter mapping", "audience": ["developer"] },
    { "id": "integration", "file": "docs/INTEGRATION.md", "title": "Integration contract", "audience": ["developer"] },
    { "id": "accounts", "file": "docs/ACCOUNTS.md", "title": "Accounts and deployment", "audience": ["operator", "developer"] },
    { "id": "eval-api", "file": "docs/EVAL_API.md", "title": "Shared-token API", "audience": ["developer"] },
    { "id": "self-hosting", "file": "docs/SELF_HOSTING.md", "title": "Shared-token setup", "audience": ["operator"] },
    { "id": "verification", "file": "docs/maintainers/VERIFY.md", "title": "Verification", "audience": ["developer"] },
    { "id": "maintainers", "file": "docs/maintainers/README.md", "title": "Maintainer runbooks", "audience": ["developer"] },
    { "id": "handoff", "file": "docs/maintainers/HANDOFF.md", "title": "Handoff and packaging", "audience": ["developer"] },
    { "id": "answer-grounding", "file": "docs/ANSWER_GROUNDING.md", "title": "Answer grounding example", "audience": ["developer", "reviewer"] },
    { "id": "open-core", "file": "docs/OPEN_CORE.md", "title": "Open-core boundary", "audience": ["all"] },
    { "id": "core-readme", "file": "README.md", "title": "Core README", "audience": ["developer"] },
    { "id": "ios-build", "file": "ios/README.md", "title": "iOS build and release", "audience": ["developer"] },
    { "id": "game-service", "file": "game-service/README.md", "title": "Optional game service", "audience": ["operator", "developer"] },
    { "id": "game-api", "file": "game-service/docs/API.md", "title": "Game API", "audience": ["developer"] },
    { "id": "game-coolify", "file": "game-service/docs/COOLIFY.md", "title": "Game deployment", "audience": ["operator"] },
    { "id": "roadmap", "file": "ROADMAP.md", "title": "Roadmap", "audience": ["all"] },
    { "id": "contributing", "file": "CONTRIBUTING.md", "title": "Contributing", "audience": ["developer"] },
    { "id": "security", "file": "SECURITY.md", "title": "Security reporting", "audience": ["all"] }
  ],
  "resources": [
    { "id": "manifest", "file": "docs/agent/manifest.json", "mediaType": "application/json" },
    { "id": "workflows", "file": "docs/agent/workflows.json", "mediaType": "application/json" },
    { "id": "api", "file": "docs/agent/api.json", "mediaType": "application/json" },
    { "id": "schemas", "file": "docs/agent/schemas.json", "mediaType": "application/schema+json" },
    { "id": "examples", "file": "docs/agent/examples.json", "mediaType": "application/json" },
    { "id": "llms", "file": "llms.txt", "mediaType": "text/plain" }
  ],
  "maintenance": { "checkCommand": "npm run docs:check", "rule": "Update route catalog, schemas, examples, workflows and relevant guide when behavior changes; do not equate source support with deployment availability." }
}
